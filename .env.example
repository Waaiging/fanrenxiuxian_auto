# Comma-separated HTTP Basic usernames.
DASHBOARD_USERS=admin

# Use a long random value and keep the real .env outside Git.
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# Browser login sessions remain valid on the same device for this many days.
DASHBOARD_SESSION_DAYS=180

# Optional independent signing secret. Keep it outside Git when configured.
DASHBOARD_SESSION_SECRET=replace-with-another-long-random-value
